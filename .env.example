# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; used for webhooks, demo simulations and seeding.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test mode (Dashboard → Settings → API Keys, in Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without it, Healthy Score, review summaries and the food assistant use built-in rules.
OPENAI_API_KEY=

# Shows the Demo Switcher, OTP 123456 and simulated riders.
NEXT_PUBLIC_DEMO_MODE=true
